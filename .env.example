# ═══════════════════════════════════════════════════════════════
# AegisPath Environment Variables Configuration
# Copy this file to .env before starting the services
# ═══════════════════════════════════════════════════════════════

# Environment mode: development | staging | production
ENVIRONMENT=development

# Simulated Testnet Network Flag
TESTNET=true

# ── API Service (Port 8000) ───────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=dev_api_secret_key_change_in_production_32char_min
API_DATABASE_URL=sqlite:///./data/api.db
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Bank Service (Port 8100, Separate Process & Secret) ───────
BANK_HOST=127.0.0.1
BANK_PORT=8100
BANK_SECRET_KEY=dev_bank_secret_key_independent_from_api_32char
BANK_DATABASE_URL=sqlite:///./data/bank.db
BANK_SERVICE_URL=http://127.0.0.1:8100

# ── Web Frontend (Port 3000) ──────────────────────────────────
WEB_PORT=3000
VITE_API_URL=http://127.0.0.1:8000
VITE_DEFAULT_LOCALE=en

# Server-only AI. Cloud requests require synthetic_demo=true.
LLM_PROVIDER=none
GEMINI_API_KEY=
GROQ=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=20
