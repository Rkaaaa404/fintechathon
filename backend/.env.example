# =============================================================================
# AegisPath Production Configuration Template
# =============================================================================
# Reference only: put these values in the repository root .env.

# 1. API Core Database
# Leave blank to automatically use local SQLite (data/api.db) for zero-dependency demo.
# Or provide a Cloud PostgreSQL connection string (Supabase, Neon, AWS RDS, etc.):
# DATABASE_URL=postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# 2. Bank Sandbox Database (Independent instance for security perimeter separation)
# Leave blank to automatically use local SQLite (data/bank.db)
# BANK_DATABASE_URL=postgresql://postgres:your_password@db.xxxx.supabase.co:5432/bank_sandbox
BANK_DATABASE_URL=

# 3. Network Ports & Host
API_HOST=127.0.0.1
API_PORT=8000
BANK_HOST=127.0.0.1
BANK_PORT=8100
BANK_SERVICE_URL=http://127.0.0.1:8100

# 4. Cryptographic Secrets (HMAC Token Signing & Session Security)
API_SECRET_KEY=dev_api_secret_key_change_in_production_32chars
BANK_SECRET_KEY=dev_bank_shared_secret_key_32chars_min_safe

# 5. Server-only AI (synthetic demo data only)
LLM_PROVIDER=none
GEMINI_API_KEY=
GROQ=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=20
