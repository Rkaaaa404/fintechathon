{
  "components": {
    "schemas": {
      "AgentMessageRequest": {
        "properties": {
          "locale": {
            "default": "en",
            "description": "Target locale: 'en' or 'zh'",
            "title": "Locale",
            "type": "string"
          },
          "synthetic_demo": {
            "default": false,
            "title": "Synthetic Demo",
            "type": "boolean"
          },
          "text": {
            "description": "Natural language prompt for financial agent",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "AgentMessageRequest",
        "type": "object"
      },
      "ApprovePlanRequest": {
        "properties": {
          "demo_consent": {
            "default": false,
            "description": "Explicit synthetic demo consent only; not WebAuthn authentication",
            "title": "Demo Consent",
            "type": "boolean"
          },
          "intent_hash": {
            "description": "Cryptographic intent hash bound to user approval",
            "minLength": 10,
            "title": "Intent Hash",
            "type": "string"
          },
          "passkey_signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Legacy parameter for demo consent marker",
            "title": "Passkey Signature"
          }
        },
        "required": [
          "intent_hash"
        ],
        "title": "ApprovePlanRequest",
        "type": "object"
      },
      "AttackReplayRequest": {
        "properties": {
          "case_id": {
            "default": "invoice_hidden_instruction_01",
            "description": "Simulated attack scenario identifier",
            "title": "Case Id",
            "type": "string"
          },
          "disabled_layers": {
            "description": "List of defensive rings to simulate bypass on",
            "items": {
              "type": "string"
            },
            "title": "Disabled Layers",
            "type": "array"
          }
        },
        "title": "AttackReplayRequest",
        "type": "object"
      },
      "DemoLoginRequest": {
        "properties": {
          "username": {
            "default": "Ayu",
            "description": "Demo student username",
            "title": "Username",
            "type": "string"
          }
        },
        "title": "DemoLoginRequest",
        "type": "object"
      },
      "EvidenceShareRequest": {
        "properties": {
          "days": {
            "default": 14,
            "description": "Link validity period in days",
            "maximum": 90.0,
            "minimum": 1.0,
            "title": "Days",
            "type": "integer"
          },
          "recipient": {
            "default": "Landlord A",
            "description": "Verified party requesting funds evidence",
            "title": "Recipient",
            "type": "string"
          }
        },
        "title": "EvidenceShareRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PolicyProposalRequest": {
        "properties": {
          "new_daily_cap_usd": {
            "description": "New proposed daily spending cap in USD",
            "exclusiveMinimum": 0.0,
            "title": "New Daily Cap Usd",
            "type": "number"
          },
          "new_single_send_cap_usd": {
            "description": "New proposed single-send cap in USD",
            "exclusiveMinimum": 0.0,
            "title": "New Single Send Cap Usd",
            "type": "number"
          }
        },
        "required": [
          "new_daily_cap_usd",
          "new_single_send_cap_usd"
        ],
        "title": "PolicyProposalRequest",
        "type": "object"
      },
      "ResumeAgentRequest": {
        "properties": {
          "demo_consent": {
            "default": false,
            "description": "Explicit synthetic demo resume consent; not WebAuthn authentication",
            "title": "Demo Consent",
            "type": "boolean"
          },
          "passkey_signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Legacy parameter for demo consent marker",
            "title": "Passkey Signature"
          }
        },
        "title": "ResumeAgentRequest",
        "type": "object"
      },
      "TokenRefreshRequest": {
        "properties": {
          "refresh_token": {
            "description": "JWT Refresh Token",
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "TokenRefreshRequest",
        "type": "object"
      },
      "TuitionQuoteRequest": {
        "properties": {
          "amount_cny": {
            "default": 18000.0,
            "description": "Tuition fee amount in CNY",
            "exclusiveMinimum": 0.0,
            "title": "Amount Cny",
            "type": "number"
          },
          "mode": {
            "default": "cheapest",
            "description": "Routing mode: 'fastest', 'cheapest', or 'balanced'",
            "title": "Mode",
            "type": "string"
          }
        },
        "title": "TuitionQuoteRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
